index.php?title=%C4%91i%E1%BB%87n_tho%E1%BA%A1i_t%C3%ADnh_n%C4%83ng&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"điện thoại tính năng (page does not exist)\">điện thoại tính năng</a></span> <span class=\"mention-gloss-paren annotation-paren\">(</span><span class=\"mention-gloss-double-quote\">“</span><span class=\"mention-gloss\">feature phone</span><span class=\"mention-gloss-double-quote\">”</span><span class=\"mention-gloss-paren annotation-paren\">)</span></li><li><span class=\"Latn\" lang=\"vi\"><a href=\"/w/index.php?title=%C4%91i%E1%BB%87n_tho%E1%BA%A1i_vi%E1%BB%85n_th%C3%B4ng&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"điện thoại viễn thông (page does not exist)\">điện thoại viễn thông</a></span> <span class=\"mention-gloss-paren annotation-paren\">(</span><span class=\"mention-gloss-double-quote\">“</span><span class=\"mention-gloss\">wireless phone</span><span class=\"mention-gloss-double-quote\">”</span><span class=\"mention-gloss-paren annotation-paren\">)</span></li><li><span class=\"Latn\" lang=\"vi\"><a href=\"/wiki/s%E1%BB%91_%C4%91i%E1%BB%87n_tho%E1%BA%A1i#Vietnamese\" title=\"số điện thoại\">số điện thoại</a></span> <span class=\"mention-gloss-paren annotation-paren\">(</span><span class=\"mention-gloss-double-quote\">“</span><span class=\"mention-gloss\">phone number</span><span class=\"mention-gloss-double-quote\">”</span><span class=\"mention-gloss-paren annotation-paren\">)</span></li></ul></div></div></div>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Verb\">Verb</h3></div>\n<p><span class=\"headword-line\"><strong class=\"Latn headword\" lang=\"vi\"><a href=\"/wiki/%C4%91i%E1%BB%87n#Vietnamese\" title=\"điện\">điện</a> <a href=\"/wiki/tho%E1%BA%A1i#Vietnamese\" title=\"thoại\">thoại</a></strong></span>\n</p>\n<ol><li>to <a href=\"/wiki/telephone\" title=\"telephone\">telephone</a>; to <a href=\"/wiki/call\" title=\"call\">call</a></li></ol>\n<div class=\"mw-heading mw-heading4\"><h4 id=\"Synonyms_2\">Synonyms</h4></div>\